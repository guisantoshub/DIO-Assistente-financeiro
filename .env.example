# Configurações de Sandbox Plaid (Obtenha em: https://dashboard.plaid.com/developers/keys)
VITE_PLAID_CLIENT_ID=seu_client_id_aqui
VITE_PLAID_SECRET=seu_secret_sandbox_aqui
VITE_PLAID_ENV=sandbox

# Configuração Streamable HTTP Pluggy (Documentação e Schemas Open Finance Brasil)
VITE_PLUGGY_MCP_URL=https://mcp.pluggy.ai/mcp

# Cotação base para conversão USD -> BRL
VITE_USD_BRL_RATE=5.85
